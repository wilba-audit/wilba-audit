# ── BahaOS environment ──────────────────────────────────────────────
# The app boots with Mock providers when credentials are omitted.

# App
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database (Postgres + pgvector — Supabase or self-hosted)
DATABASE_URL="postgresql://user:pass@host:5432/bahaos"

# Media storage (local for MVP; swap to S3/R2 via MediaStorageProvider)
MEDIA_STORAGE_DRIVER="local"          # local | s3
MEDIA_ROOT="./media"                  # used when driver=local
# S3_ENDPOINT=""
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_REGION="auto"

# Language + Vision (Anthropic Claude)
ANTHROPIC_API_KEY=""
LANGUAGE_MODEL="claude-opus-4-8"      # reasoning: creative director, copywriter, critic
VISION_MODEL="claude-opus-4-8"        # image + sampled-frame analysis

# Embeddings (multimodal — choose one; dimension must match db/schema.ts)
EMBEDDING_PROVIDER="mock"             # mock | voyage | openai
# VOYAGE_API_KEY=""
# OPENAI_API_KEY=""

# Creative video (Higgsfield)
CREATIVE_VIDEO_PROVIDER="mock"        # mock | higgsfield
# HIGGSFIELD_API_KEY=""
# HIGGSFIELD_API_BASE=""

# Publishing (Meta Instagram Content Publishing API)
PUBLISHER_DRIVER="mock"               # mock | meta
# META_APP_ID=""
# META_APP_SECRET=""
# META_ACCESS_TOKEN=""
# META_IG_BUSINESS_ACCOUNT_ID=""
# META_FB_PAGE_ID=""

# Cost control
GENERATION_MONTHLY_BUDGET_USD="100"
GENERATION_CONFIRM_THRESHOLD_USD="2"

# Timezone (West Sumbawa)
DEFAULT_TIMEZONE="Asia/Makassar"      # WITA (UTC+8)
